<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Add-in de Revit 2027 (.NET 10). Compila en Linux gracias a EnableWindowsTargeting y a los paquetes
    Nice3point.Revit.Api (solo referencias, no se copian). Todo lo que dependa de RevitAPISteel.dll o de
    Advance Steel NO va aquí (no está en NuGet): iría en un proyecto aparte compilado solo en el PC.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Fase 6: ventanas WPF (UI/). Compila en Linux con EnableWindowsTargeting (comprobado en la nube). -->
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MotorConexiones.Revit</RootNamespace>
    <AssemblyName>MotorConexiones.Revit</AssemblyName>
    <Version>0.2.1</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.2.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotorConexiones.Core\MotorConexiones.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MotorConexiones.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
