<Window x:Class="MotorConexiones.Revit.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MotorConexiones.Revit.UI"
        Title="MotorConexiones: previsualización de conexión"
        Width="1320" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
  </Window.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="200" MinHeight="120" />
    </Grid.RowDefinitions>

    <!-- Cabecera: archivo y resumen -->
    <StackPanel Grid.Row="0" Margin="0,0,0,6">
      <TextBlock x:Name="FileText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="SummaryText" Foreground="#444" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Centro: croquis a la izquierda, tabla a la derecha -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="400" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1" Background="White">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Background="#ECECEC" LastChildFill="True">
            <Button x:Name="FitButton" DockPanel.Dock="Left" Content="Ajustar" Click="OnFit" Margin="4" MinWidth="70" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0" Foreground="#555"
                       Text="Rueda: zoom · Botón central o arrastrar: encuadre · Doble clic en una cota: editar su valor · Cotas en mm" />
            <TextBlock x:Name="SketchNotesText" VerticalAlignment="Center" Margin="6,0" Foreground="#B25B00" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ui:SketchCanvas x:Name="Canvas" Grid.Row="1" />
          <!-- Editor en sitio de una cota (ronda 6b): aparece junto a la cota con doble clic; Enter aplica, Esc cancela. -->
          <Border x:Name="DimensionEditor" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="10"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFFFF4D6" BorderBrush="#E06C00"
                  BorderThickness="1.5" CornerRadius="3" Padding="7,5">
            <StackPanel>
              <TextBlock x:Name="DimensionEditorLabel" FontSize="10.5" Foreground="#444" Margin="0,0,0,3" />
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text=" mm" VerticalAlignment="Center" Foreground="#444" />
                <TextBox x:Name="DimensionEditorBox" MinWidth="96" FontSize="13" FontWeight="SemiBold"
                         PreviewKeyDown="OnDimensionEditorKeyDown" LostKeyboardFocus="OnDimensionEditorLostFocus" />
              </DockPanel>
              <TextBlock FontSize="10" Foreground="#777" Margin="0,3,0,0" Text="Enter aplica · Esc cancela" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="110" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="FieldsGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single"
                  SelectionUnit="FullRow" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F7F7"
                  BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding" SelectionChanged="OnFieldSelected"
                  ToolTip="Haz doble clic en un valor para editarlo. Enter aplica el cambio: el croquis se redibuja y se vuelve a validar.">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Sección" Binding="{Binding Section}" IsReadOnly="True" Width="150" />
            <DataGridTextColumn Header="Campo" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
            <DataGridTextColumn Header="Valor" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="140" />
            <DataGridTextColumn Header="Ruta JSON" Binding="{Binding Path}" IsReadOnly="True" Width="200" FontSize="10" Foreground="#777777" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Margin="0,6,0,2" Text="Contorno de la cartela (gusset.outline.points_mm): un punto por línea, x; y en mm" />
        <DockPanel Grid.Row="2" LastChildFill="True">
          <Button x:Name="ApplyOutlineButton" DockPanel.Dock="Right" Content="Aplicar contorno" Click="OnApplyOutline" VerticalAlignment="Top" />
          <TextBox x:Name="OutlineBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap" />
        </DockPanel>
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD" Margin="0,6,0,0" />

    <!-- Abajo: estado, errores y botones -->
    <Grid Grid.Row="3" Margin="0,4,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ListView x:Name="IssuesList" Grid.Row="1" Margin="0,4,0,0" BorderBrush="#B8B8B8">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Tipo" Width="60" DisplayMemberBinding="{Binding Severity}" />
            <GridViewColumn Header="Código" Width="210" DisplayMemberBinding="{Binding Code}" />
            <GridViewColumn Header="Campo" Width="230" DisplayMemberBinding="{Binding Path}" />
            <GridViewColumn Header="Mensaje" Width="420" DisplayMemberBinding="{Binding Message}" />
            <GridViewColumn Header="Sugerencia" Width="360" DisplayMemberBinding="{Binding Hint}" />
          </GridView>
        </ListView.View>
      </ListView>
      <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ReloadButton" Content="Recargar" Click="OnReload" ToolTip="Vuelve a leer el archivo JSON del disco (por si lo corrigió el chat o un editor)." />
          <Button x:Name="SaveButton" Content="Guardar JSON" Click="OnSave" ToolTip="Guarda el JSON corregido junto al original con sufijo -corregido.json. Nunca escribe encima del original." />
          <Button x:Name="ValidateButton" Content="Validar" Click="OnValidate" />
          <Button x:Name="CreateButton" Content="Crear" Click="OnCreate" FontWeight="Bold" IsEnabled="False" ToolTip="Solo se activa con la validación en verde." />
          <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="TokenText" VerticalAlignment="Center" Foreground="#555" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
