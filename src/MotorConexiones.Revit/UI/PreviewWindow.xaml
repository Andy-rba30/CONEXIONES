<Window x:Class="MotorConexiones.Revit.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MotorConexiones.Revit.UI"
        Title="MotorConexiones · Previsualización de conexión"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="FieldRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Foreground" Value="#707070" />
                    <Setter Property="Background" Value="#F4F4F4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessageRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#B00020" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Aviso">
                    <Setter Property="Foreground" Value="#8A5A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Nudo">
                    <Setter Property="Foreground" Value="#B00020" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="6" />
            <RowDefinition Height="200" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Arriba: croquis a la izquierda, tabla editable a la derecha -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="4*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="FitButton" DockPanel.Dock="Right" Content="Ajustar" Click="OnFitClick" ToolTip="Encuadra todo el croquis" />
                    <TextBlock x:Name="SketchTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="Croquis en el plano de la cercha (mm, sistema local del nudo)" />
                </DockPanel>
                <TextBlock x:Name="SketchNotes" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,4,0,0" />
                <Border BorderBrush="#B0B0B0" BorderThickness="1">
                    <ui:SketchView x:Name="Sketch" />
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E0E0E0" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold"
                           Text="Datos de la conexión (edita el valor y pulsa Intro; coma o punto decimal)" />
                <DataGrid x:Name="FieldsGrid"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" SelectionUnit="Cell" SelectionMode="Single"
                          RowStyle="{StaticResource FieldRowStyle}"
                          BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Padding="4,6,4,2" Background="#E8EEF7" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Campo" Binding="{Binding Label}" IsReadOnly="True" Width="2.2*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="1.6*" />
                        <DataGridTextColumn Header="Ruta JSON" Binding="{Binding Path}" IsReadOnly="True" Width="2*" FontSize="10" Foreground="#707070" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#505050" Margin="8,2,8,6" FontSize="11" />
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#E0E0E0" />

        <!-- Abajo: errores y avisos del validador -->
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="ValidationTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Validación" />
            <DataGrid x:Name="MessagesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      RowStyle="{StaticResource MessageRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Level}" Width="60" />
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="200" />
                    <DataGridTextColumn Header="Campo" Binding="{Binding Path}" Width="220" />
                    <DataGridTextColumn Header="Mensaje" Binding="{Binding Message}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sugerencia" Binding="{Binding Hint}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Estado y botones -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#505050" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadButton" Content="Recargar" Click="OnReloadClick" ToolTip="Vuelve a leer el archivo JSON del disco" />
                <Button x:Name="SaveButton" Content="Guardar JSON" Click="OnSaveClick" ToolTip="Guarda una copia corregida junto al original (-corregido.json)" />
                <Button x:Name="ValidateButton" Content="Validar" Click="OnValidateClick" ToolTip="Vuelve a validar contra el modelo" />
                <Button x:Name="CreateButton" Content="Crear" Click="OnCreateClick" FontWeight="Bold" ToolTip="Crea la conexión en el modelo (solo con validación en verde)" />
                <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
