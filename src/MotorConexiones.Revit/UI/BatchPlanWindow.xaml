<Window x:Class="MotorConexiones.Revit.UI.BatchPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MotorConexiones.Revit.UI"
        Title="MotorConexiones: conectar cercha (plan y lote)"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="4,0,0,4" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <!-- Fase 9 (mejora C3): botones pequeños dentro de la columna Qué hacer -->
    <Style x:Key="AdviceButton" TargetType="Button">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,2,4,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="210" MinHeight="90" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Intro -->
    <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#444"
               Text="El plan detecta los nudos de la selección, casa cada uno con las plantillas del catálogo y los valida; Crear N conexiones los crea nudo a nudo (si uno falla, los demás se quedan y la tabla dice por qué; Ctrl+Z deshace el lote entero) y Borrar el lote los quita. En el modelo, cada nudo lleva el color de su estado, un marcador con su nombre (cubo = igual que la plantilla, rombo = en espejo) y una etiqueta con su número: pincharla en la vista elige su fila aquí, y elegir una fila la resalta allí. Al crear, las marcas de los nudos creados se quitan. Esta ventana se queda abierta: orbita y pincha en Revit cuando quieras; Ver en Revit solo encuadra el nudo." />

    <!-- Cabecera con la decisión -->
    <Border Grid.Row="1" Background="White" BorderBrush="#B8B8B8" BorderThickness="1" Padding="10,6" Margin="0,0,0,6">
      <StackPanel>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="Bold" FontSize="13.5" />
        <TextBlock x:Name="PlanInfoText" TextWrapping="Wrap" Foreground="#666" FontSize="10.5" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <!-- Ocultos y ajuste del mapa -->
    <DockPanel Grid.Row="2" Margin="0,0,0,4" LastChildFill="True">
      <Button x:Name="FitButton" DockPanel.Dock="Right" Content="Ajustar" MinWidth="70" Margin="4,0,0,0" Click="OnFitMap"
              ToolTip="Encuadra toda la cercha en el mapa (rueda = zoom, arrastrar = mover)." />
      <ToggleButton x:Name="HiddenToggle" DockPanel.Dock="Right" Content="Mostrar ocultos" Click="OnToggleHidden"
                    ToolTip="Enseña en gris, al final de la tabla y como círculos vacíos en el mapa, las barras sueltas y las parejas sin cordón (no son nudos de verdad)." />
      <TextBlock x:Name="HiddenText" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap" />
    </DockPanel>

    <!-- Mapa de la cercha -->
    <Border Grid.Row="3" Background="White" BorderBrush="#B8B8B8" BorderThickness="1">
      <ui:TrussMapCanvas x:Name="MapCanvas" />
    </Border>
    <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D8D8D8" Margin="0,2" />

    <!-- Tabla del plan -->
    <DataGrid x:Name="NodesGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F7F7" SelectionChanged="OnSelectionChanged"
              MouseDoubleClick="OnRowDoubleClick" PreviewMouseRightButtonDown="OnGridRightClick" VerticalScrollBarVisibility="Auto">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Detail}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
              <Setter Property="Foreground" Value="#8A8A8A" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.ContextMenu>
        <ContextMenu x:Name="RowMenu" Opened="OnRowMenuOpened">
          <MenuItem x:Name="MenuShow" Header="Ver en Revit" Click="OnShowInRevit" />
          <MenuItem x:Name="MenuEdit" Header="Editar nudo" Click="OnEditNode" />
          <MenuItem x:Name="MenuClearEdit" Header="Quitar edición" Click="OnClearEdit" />
          <Separator />
          <MenuItem x:Name="MenuExclude" Header="Excluir" Click="OnToggleExclude" />
          <MenuItem x:Name="MenuChord" Header="Cordón…" Click="OnChord" />
          <MenuItem x:Name="MenuMembers" Header="Barras…" Click="OnMembers" />
          <MenuItem x:Name="MenuTemplate" Header="Plantilla…" Click="OnTemplate" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nudo" Binding="{Binding Name}" Width="54" />
        <DataGridTemplateColumn Header="Estado" Width="182" SortMemberPath="StatusText">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="2,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Espejo" Binding="{Binding Mirror}" Width="58" />
        <DataGridTextColumn Header="Plantilla" Binding="{Binding Template}" Width="160" />
        <DataGridTextColumn Header="Desvío" Binding="{Binding Deviation}" Width="56" />
        <DataGridTemplateColumn Header="Qué hacer" Width="*" SortMemberPath="Advice">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Margin="2,1">
                <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Actions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Label}" Tag="{Binding}" Style="{StaticResource AdviceButton}" Click="OnAdviceButton" ToolTip="{Binding ToolTip}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Detalle del nudo -->
    <Border Grid.Row="6" Margin="0,6,0,0" Padding="8,6" Background="White" BorderBrush="#B8B8B8" BorderThickness="1" MinHeight="78" MaxHeight="150">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#333" Text="Elige un nudo (en la tabla o en el mapa) para ver sus barras, su casado, sus avisos y sus errores. Clic derecho en un nudo: excluir, cordón, barras, plantilla." />
      </ScrollViewer>
    </Border>

    <!-- Leyenda -->
    <TextBlock x:Name="LegendText" Grid.Row="7" Margin="0,6,0,0" Foreground="#555" FontSize="11" />

    <!-- Estado y botones -->
    <DockPanel Grid.Row="8" Margin="0,4,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MoreButton" Content="Más…" Click="OnMore" ToolTip="Completar la selección, añadir nudo, guardar el plan en JSON, borrar el lote o descartar el plan.">
          <Button.ContextMenu>
            <ContextMenu x:Name="MoreMenu">
              <MenuItem x:Name="MenuExpandSelection" Header="Completar selección" Click="OnExpandSelection" ToolTip="Añade a la selección del plan las barras que la tocan (cordones que pasan de largo, barras que llegan, tramos del cordón) dentro del plano de la cercha y replanifica." />
              <MenuItem Header="Añadir nudo…" Click="OnAddNode" ToolTip="Pinchar en Revit las barras de un nudo que no se detectó." />
              <MenuItem Header="Guardar plan JSON" Click="OnSavePlan" ToolTip="Escribe el plan (nudos, especificaciones, tokens y el último informe) en Documentos\MotorConexiones\." />
              <MenuItem x:Name="MenuDeleteBatch" Header="Borrar el lote" Click="OnDeleteBatch" ToolTip="Borra todas las conexiones creadas por este plan (solo lo que creó el add-in; las barras recuperan su extensión) y replanifica. Una sola entrada de deshacer." />
              <MenuItem Header="Descartar plan" Click="OnDiscard" ToolTip="Quita todos los colores y marcadores del modelo (también los de otros planes) y olvida el plan. No toca las conexiones creadas." />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="DeleteBatchButton" Content="Borrar el lote" Click="OnDeleteBatch" Visibility="Collapsed"
                ToolTip="Borra todas las conexiones creadas por este plan (solo lo que creó el add-in; las barras recuperan su extensión) y replanifica. Una sola entrada de deshacer." />
        <Button x:Name="ReplanButton" Content="Replanificar" Click="OnReplan" ToolTip="Vuelve a detectar, casar y validar con la misma selección y las correcciones acumuladas." />
        <Button x:Name="EditButton" Content="Editar nudo" Click="OnEditNode" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                ToolTip="Abre la ventana de previsualización con la especificación de este nudo; lo que cambies sustituye a la plantilla solo aquí. Solo para nudos con especificación (listos o que no validan)." />
        <Button x:Name="ShowButton" Content="Ver en Revit" Click="OnShowInRevit" IsEnabled="False"
                ToolTip="Selecciona las barras del nudo y lo encuadra en la vista activa, sin cuadros de Revit y sin cerrar esta ventana." />
        <Button x:Name="CreateButton" Content="Crear N conexiones" Click="OnCreateBatch" IsEnabled="False" FontWeight="Bold" MinWidth="150" ToolTipService.ShowOnDisabled="True"
                ToolTip="Crea las conexiones de los nudos listos (y reintenta los fallidos) con los tokens del plan: cada nudo por separado, una sola entrada de deshacer (Ctrl+Z)." />
        <Button x:Name="CloseButton" Content="Cerrar" Click="OnClose" IsCancel="True" ToolTip="Cierra la ventana dejando las marcas y el plan para seguir después (el botón Planificar lote lo reabre)." />
      </StackPanel>
      <Button x:Name="CatalogButton" DockPanel.Dock="Left" Content="Abrir catálogo" Click="OnOpenCatalog" Visibility="Collapsed" Margin="0,0,8,4"
              ToolTip="El catálogo no tiene plantillas: ábrelo para guardar la conexión de un nudo como plantilla; al cerrarlo se replanifica." />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</Window>
