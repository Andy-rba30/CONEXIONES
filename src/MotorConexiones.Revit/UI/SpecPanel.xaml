<UserControl x:Class="MotorConexiones.Revit.UI.SpecPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <Style TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BorderBrush" Value="#C8C8C8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="Foreground" Value="#333" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldError" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B01E1E" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="MinWidth" Value="80" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Cabecera: la plantilla propuesta con su miniatura (V4), Cambiar…, o el aviso de arranque con Encargo para IA. -->
    <Border x:Name="HeaderBorder" Grid.Row="0" Background="#FFF8E7" BorderBrush="#E0C080" BorderThickness="1" Padding="8,6" Margin="0,0,0,6" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="HeaderImageBorder" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1" Background="White" Margin="0,0,8,0" VerticalAlignment="Top" Visibility="Collapsed">
          <Image x:Name="HeaderImage" Width="120" Height="90" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Foreground="#333" />
          <TextBlock x:Name="HeaderWarningText" TextWrapping="Wrap" Foreground="#B25B00" Margin="0,3,0,0" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Margin="-6,6,0,0">
            <Button x:Name="ChangeButton" Content="Cambiar…" Style="{StaticResource HeaderButton}" Click="OnChangeTemplate" Visibility="Collapsed"
                    ToolTip="Elige otra de las plantillas que encajan con este nudo (con su miniatura, desvío y orientación); se vuelve a instanciar." />
            <Button x:Name="BriefButton" Content="Encargo para IA" Style="{StaticResource HeaderButton}" Click="OnBrief" Visibility="Collapsed"
                    ToolTip="Escribe el encargo para una IA externa sobre este mismo nudo (lo mismo que el botón de la cinta)." />
            <Button x:Name="CatalogButton" Content="Abrir catálogo" Style="{StaticResource HeaderButton}" Click="OnOpenCatalog" Visibility="Collapsed"
                    ToolTip="El catálogo no tiene plantillas: crea un nudo y guárdalo como plantilla, o aplica una si ya la tienes." />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Sections" />
    </ScrollViewer>
  </Grid>
</UserControl>
