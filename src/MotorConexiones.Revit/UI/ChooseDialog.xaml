<Window x:Class="MotorConexiones.Revit.UI.ChooseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MotorConexiones" Width="520" Height="420" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" />
    <!-- Fase 11 (V4): cada opción puede llevar una miniatura (plantillas); sin imagen, solo el texto. -->
    <ListBox x:Name="ItemsList" Grid.Row="1" MouseDoubleClick="OnDoubleClick" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <Image Source="{Binding Image}" Width="96" Height="72" Stretch="Uniform" Margin="0,0,8,0">
              <Image.Style>
                <Style TargetType="Image">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasImage}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
      <Button x:Name="PickButton" DockPanel.Dock="Left" Content="Pinchar en Revit…" Click="OnPick" Padding="10,4" MinWidth="130"
              ToolTip="Cierra las ventanas, elige en el modelo y vuelve con la elección." />
      <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar" Click="OnCancel" IsCancel="True" Padding="10,4" MinWidth="90" Margin="6,0,0,0" />
      <Button x:Name="OkButton" DockPanel.Dock="Right" Content="Aceptar" Click="OnOk" IsDefault="True" Padding="10,4" MinWidth="90" FontWeight="Bold" />
    </DockPanel>
  </Grid>
</Window>
