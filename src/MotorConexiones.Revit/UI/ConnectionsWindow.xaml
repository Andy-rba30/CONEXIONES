<Window x:Class="MotorConexiones.Revit.UI.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MotorConexiones · Conexiones del modelo"
        Width="980" Height="520" MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Conexiones creadas por MotorConexiones en el documento activo (lo mismo que conn_list). Borrar quita solo lo que creó el add-in y devuelve a las barras sus extensiones originales (lo mismo que conn_delete)." />

        <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id de conexión" Binding="{Binding Id}" Width="250" FontFamily="Consolas" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="110" />
                <DataGridTextColumn Header="Plano" Binding="{Binding Drawing}" Width="110" />
                <DataGridTextColumn Header="Creada" Binding="{Binding Created}" Width="140" />
                <DataGridTextColumn Header="Elementos" Binding="{Binding ElementsCount}" Width="80" />
                <DataGridTextColumn Header="Barras (ElementId)" Binding="{Binding Members}" Width="*" />
                <DataGridTextColumn Header="Backend" Binding="{Binding Backend}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Actualizar" Click="OnRefreshClick" />
                <Button x:Name="DeleteButton" Content="Borrar seleccionada" Click="OnDeleteClick" IsEnabled="False" FontWeight="Bold" />
                <Button x:Name="CloseButton" Content="Cerrar" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
